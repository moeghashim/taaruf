# Convex
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
CONVEX_DEPLOY_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Admin
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_TOKEN_SALT=taaruf-admin-salt
# Server-to-server credential: set the same private value here (Next server)
# and as ATTENDANCE_ADMIN_SECRET in the isolated Convex deployment environment.
# Required by protected admin, applicant-auth, signup, upload, and receipt calls.
# ADMIN_PASSWORD authenticates dashboard sign-in on Next; it is not this credential.
# Never prefix this secret with NEXT_PUBLIC_ or expose it to browser callers.
ATTENDANCE_ADMIN_SECRET=

# Resend (email)
RESEND_API_KEY=re_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
